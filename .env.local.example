# ============================================
# AI 投研平台 - 环境变量配置
# ============================================
# 将此文件复制为 .env.local 并填入你的配置
# cp .env.local.example .env.local

# ============================================
# Tushare 数据源配置（必须）
# ============================================
# Tushare API Token - 从 https://tushare.pro 注册获取
# 注意：此 token 只能在服务端使用，绝对不能暴露到浏览器端
TUSHARE_TOKEN=your_tushare_token_here

# Tushare API 基础 URL（可选，默认 http://api.tushare.pro）
# TUSHARE_BASE_URL=http://api.tushare.pro

# ============================================
# 管理接口配置（必须）
# ============================================
# 刷新市场数据的密钥 - 用于 POST /api/admin/refresh-market
# 请设置一个强密码，调用时需要通过 x-admin-secret header 传入
ADMIN_REFRESH_SECRET=your_admin_secret_here

# ============================================
# 数据存储配置（可选）
# ============================================
# 如果不配置，数据会存储到 .cache/ 目录（本地文件）
# 如果配置了 Supabase，数据会存储到 Supabase 数据库

# Supabase 项目 URL
# SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key（服务端专用，不要暴露到浏览器）
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# 数据模式配置（可选）
# ============================================
# live: 使用真实 Tushare 数据（默认）
# mock: 强制使用 mock 数据（开发测试用）
# DATA_MODE=live
